#include <stdio.h>    // Entrada e saída de dados
#include <stdlib.h>   // calloc, free, rand, srand
#include <string.h>   // Manipulação de strings
#include <time.h>     // time() para semente do rand

#define QTD_TERRITORIOS 5   // Quantidade fixa de territórios
#define TAM 50              // Tamanho máximo das strings

/* =========================================================
    NÍVEL NOVATO – STRUCT E CONSTANTES
   ========================================================= */

/* Estrutura que representa um território do jogo */
typedef struct {
    char nome[TAM];   // Nome do território
    char cor[TAM];    // Cor do exército dominante
    int tropas;       // Quantidade de tropas
} Territorio;

/* =========================================================
    NÍVEL MESTRE – TIPOS ABSTRATOS (MISSÕES)
   ========================================================= */

/* Enumeração para representar os tipos de missão */
typedef enum {
    MISSAO_VERDE = 1,
    MISSAO_CONQUISTA = 2
} Missao;

/* =========================================================
    PROTÓTIPOS DAS FUNÇÕES (TODOS JUNTOS)
   ========================================================= */

/* Nível Novato – Entrada/Saída */
void exibirMapa(Territorio *t);

/* Nível Aventureiro – Ponteiros, Memória Dinâmica e Jogo */
void atacar(Territorio *t, int atk, int def);

/* Nível Mestre – Modularização e Missões */
void inicializarTerritorios(Territorio *t);
Missao sortearMissao();
int verificarMissao(const Territorio *t, Missao m);
void menu();

/* =========================================================
    FUNÇÃO PRINCIPAL (ORQUESTRA O JOGO)
   ========================================================= */

int main() {

    // Ponteiro para os territórios alocados dinamicamente
    Territorio *territorios;

    // Alocação dinâmica de memória com calloc
    territorios = (Territorio *) calloc(QTD_TERRITORIOS, sizeof(Territorio));

    // Verifica erro de alocação
    if (territorios == NULL) {
        printf("Erro de alocação de memória.\n");
        return 1;
    }

    // Inicializa o gerador de números aleatórios
    srand(time(NULL));

    // Inicialização automática dos territórios (Nível Mestre)
    inicializarTerritorios(territorios);

    // Sorteio da missão (Nível Mestre)
    Missao missao = sortearMissao();

    printf("\n====== MISSÃO SORTEADA =======\n");
    if (missao == MISSAO_VERDE)
        printf(" Destruir o exército Verde\n");
    else
        printf(" Conquistar 3 territórios\n");

    // Exibe o mapa (Nível Novato)
    exibirMapa(territorios);

    int opcao, atacante, defensor;

    // Loop principal do jogo (Nível Aventureiro + Mestre)
    do {
        menu(); // Menu modularizado (Nível Mestre)
        scanf("%d", &opcao);
        getchar(); // Limpa buffer

        switch (opcao) {

            case 1:
                printf("Território ATACANTE (1 a 5): ");
                scanf("%d", &atacante);

                printf("Território DEFENSOR (1 a 5): ");
                scanf("%d", &defensor);
                getchar();

                if (atacante >= 1 && atacante <= 5 &&
                    defensor >= 1 && defensor <= 5 &&
                    atacante != defensor) {

                    // Lógica de batalha (Nível Aventureiro)
                    atacar(territorios, atacante - 1, defensor - 1);
                } else {
                    printf(" Escolha inválida.\n");
                }

                // Atualiza o mapa (Nível Novato)
                exibirMapa(territorios);
                break;

            case 2:
                // Verificação da missão (Nível Mestre)
                if (verificarMissao(territorios, missao)) {
                    printf("\n MISSÃO CONCLUÍDA COM SUCESSO! \n");
                    opcao = 0; // Encerra o jogo
                } else {
                    printf("\n Missão ainda não concluída.\n");
                }
                break;

            case 0:
                printf("Encerrando o jogo...\n");
                break;

            default:
                printf("Opção inválida.\n");
        }

    } while (opcao != 0);

    // Liberação da memória alocada dinamicamente (Nível Aventureiro)
    free(territorios);

    return 0;
}

/* =========================================================
    NÍVEL NOVATO – STRUCT, VETOR, ENTRADA/SAÍDA
   ========================================================= */

/* Função que exibe o estado atual do mapa */
void exibirMapa(Territorio *t) {

    printf("\n======= ESTADO ATUAL DO MAPA =======\n");

    // Percorre todos os territórios e exibe seus dados
    for (int i = 0; i < QTD_TERRITORIOS; i++) {
        printf("Território %d\n", i + 1);
        printf("Nome: %s", t[i].nome);
        printf("Cor do Exército: %s", t[i].cor);
        printf("Tropas: %d\n\n", t[i].tropas);
    }
}

/* =========================================================
    NÍVEL AVENTUREIRO – PONTEIROS, MEMÓRIA DINÂMICA E JOGO
   ========================================================= */

/* Função que simula uma batalha entre dois territórios */
void atacar(Territorio *t, int atk, int def) {

    // Sorteia valores aleatórios entre 1 e 6
    int dadoAtk = rand() % 6 + 1;
    int dadoDef = rand() % 6 + 1;

    printf("\n======= BATALHA =======\n");
    printf("Atacante (%s) rolou: %d\n", t[atk].nome, dadoAtk);
    printf("Defensor (%s) rolou: %d\n", t[def].nome, dadoDef);

    // Empate favorece o atacante
    if (dadoAtk >= dadoDef) {

        // Defensor perde uma tropa
        t[def].tropas--;
        printf("Atacante venceu! Defensor perde 1 tropa.\n");

        // Se o defensor ficar sem tropas, o território é conquistado
        if (t[def].tropas <= 0) {
            printf("🏳️ Território conquistado!\n");

            // A cor do território passa a ser a do atacante
            strcpy(t[def].cor, t[atk].cor);

            // Território conquistado inicia com 1 tropa
            t[def].tropas = 1;
        }

    } else {
        // Caso o defensor vença
        printf("Defensor resistiu ao ataque.\n");
    }
}

/* =========================================================
   NÍVEL MESTRE – MODULARIZAÇÃO, DESIGN LIMPO E MISSÕES
   ========================================================= */

/* Função que inicializa automaticamente os territórios */
void inicializarTerritorios(Territorio *t) {

    const char *nomes[] = {
        "América",
        "África",
        "Europa",
        "Oceania",
        "Ásia"
    };

    const char *cores[] = {
        "Verde",
        "Azul",
        "Vermelho",
        "Amarelo",
        "Branco"
    };

    // Inicializa cada território com nome, cor e tropas
    for (int i = 0; i < QTD_TERRITORIOS; i++) {
        strcpy(t[i].nome, nomes[i]);
        strcat(t[i].nome, "\n");

        strcpy(t[i].cor, cores[i]);
        strcat(t[i].cor, "\n");

        t[i].tropas = 3;
    }
}

/* Função que sorteia uma missão aleatória */
Missao sortearMissao() {
    return (rand() % 2) + 1;
}

/* Função que verifica se a missão foi cumprida */
int verificarMissao(const Territorio *t, Missao m) {

    int contador;

    // Missão 1: Destruir o exército Verde
    if (m == MISSAO_VERDE) {
        for (int i = 0; i < QTD_TERRITORIOS; i++) {
            if (strstr(t[i].cor, "Verde") != NULL) {
                return 0; // Ainda existe exército verde
            }
        }
        return 1; // Missão cumprida
    }

    // Missão 2: Conquistar 3 territórios da mesma cor
    if (m == MISSAO_CONQUISTA) {
        for (int i = 0; i < QTD_TERRITORIOS; i++) {
            contador = 0;
            for (int j = 0; j < QTD_TERRITORIOS; j++) {
                if (strcmp(t[i].cor, t[j].cor) == 0) {
                    contador++;
                }
            }
            if (contador >= 3) {
                return 1; // Missão cumprida
            }
        }
    }

    return 0; // Missão não cumprida
}

/* Função que exibe o menu principal */
void menu() {
    printf("\n======= MENU PRINCIPAL =======\n");
    printf("1 - Atacar\n");
    printf("2 - Verificar Missão\n");
    printf("0 - Sair\n");
    printf("Escolha uma opção: ");
}
